@model Ecommerce.Core.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Register";
}
<div class="sc-container">
    <div class="sc-auth-wrap">
        <div class="sc-auth-brand">
            <a class="sc-logo" href="@Url.Action("Index", "Home")" aria-label="Shopcart home" style="margin-bottom:6px">
                <span class="sc-logo-mark">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" /></svg>
                </span>
                <span class="sc-logo-name" style="color:#fff">Shop<em>cart</em></span>
            </a>
            <h2>Create your account</h2>
            <p>Join Shopcart for faster checkout, order tracking, and a cart that follows you across visits.</p>
        </div>
        <div class="sc-auth-form">
            <h1>Register</h1>
            <p>Already have an account? @Html.ActionLink("Log in", "Login")</p>
            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("", new { @class = "text-danger" })
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
                    <div class="sc-field">
                        @Html.LabelFor(m => m.FirstName)
                        @Html.TextBoxFor(m => m.FirstName, new { @class = "sc-input" })
                        @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                    </div>
                    <div class="sc-field">
                        @Html.LabelFor(m => m.LastName)
                        @Html.TextBoxFor(m => m.LastName, new { @class = "sc-input" })
                        @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="sc-field">
                    @Html.LabelFor(m => m.Email)
                    @Html.TextBoxFor(m => m.Email, new { @class = "sc-input", type = "email", autocomplete = "email" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>
                <div class="sc-field">
                    @Html.LabelFor(m => m.Password)
                    @Html.PasswordFor(m => m.Password, new { @class = "sc-input", autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                </div>
                <div class="sc-field">
                    @Html.LabelFor(m => m.ConfirmPassword)
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "sc-input", autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                </div>
                <button type="submit" class="sc-btn sc-btn-primary sc-btn-lg sc-btn-block">Create account</button>
            }
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
