@model Ecommerce.Core.ViewModels.OrderHistoryViewModel
@{
    ViewBag.Title = "My Orders";
}
<h2>My Orders</h2>
@if (Model.Orders.Count == 0)
{
    <div class="alert alert-info">
        You have no orders yet. @Html.ActionLink("Start shopping", "Index", "Product").
    </div>
}
else
{
    <table id="orders-table" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Order Number</th>
                <th>Date</th>
                <th>Status</th>
                <th>Items</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model.Orders)
            {
                <tr>
                    <td>@o.OrderNumber</td>
                    <td>@o.OrderDate.ToLocalTime().ToString("g")</td>
                    <td>@o.Status</td>
                    <td>@o.ItemCount</td>
                    <td>@o.Total.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}

@section scripts {
    <script type="text/javascript">
        $(function () {
            $('#orders-table').DataTable({
                "order": [[1, "desc"]],
                "pageLength": 10
            });
        });
    </script>
}
