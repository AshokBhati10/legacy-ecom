@model Ecommerce.Core.ViewModels.CheckoutPaymentViewModel
@{
    ViewBag.Title = "Checkout - Payment";
    var summary = ViewBag.Summary as Ecommerce.Core.ViewModels.CheckoutSummaryViewModel;
}
<div class="sc-container">
    <div class="sc-page-head">
        <div class="sc-crumbs">@Html.ActionLink("Home", "Index", "Home") &rsaquo; @Html.ActionLink("Cart", "Index", "Cart") &rsaquo; Checkout</div>
        <h1>Checkout</h1>
    </div>
    <ol class="sc-steps">
        <li class="done">@Html.ActionLink("1. Address", "Address", "Checkout")</li>
        <li class="done">@Html.ActionLink("2. Shipping", "Shipping", "Checkout")</li>
        <li class="active">3. Payment</li>
        <li>4. Confirmation</li>
    </ol>

    <div class="sc-checkout-layout">
        <div class="sc-card">
            <h3>Payment method</h3>
            @using (Html.BeginForm("Payment", "Checkout", FormMethod.Post, new { role = "form", id = "payment-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <label class="sc-pay-option">
                    @Html.RadioButtonFor(m => m.PaymentMethod, "CashOnDelivery", new { id = "pm-cod" })
                    <span><strong>Cash on Delivery</strong><br /><small class="text-muted">Pay when your order arrives</small></span>
                </label>
                <label class="sc-pay-option">
                    @Html.RadioButtonFor(m => m.PaymentMethod, "Card", new { id = "pm-card" })
                    <span><strong>Credit / Debit Card</strong><br /><small class="text-muted">Demo only — no real charge is made</small></span>
                </label>

                <div id="card-fields" style="display:none;margin-top:6px">
                    <h3 style="margin-top:8px">Card details</h3>
                    <div class="sc-field">
                        @Html.LabelFor(m => m.CardholderName)
                        @Html.TextBoxFor(m => m.CardholderName, new { @class = "sc-input" })
                        @Html.ValidationMessageFor(m => m.CardholderName, "", new { @class = "text-danger" })
                    </div>
                    <div class="sc-field">
                        @Html.LabelFor(m => m.CardNumber)
                        @Html.TextBoxFor(m => m.CardNumber, new { @class = "sc-input", autocomplete = "off" })
                        @Html.ValidationMessageFor(m => m.CardNumber, "", new { @class = "text-danger" })
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
                        <div class="sc-field">
                            @Html.Label("Expiry month")
                            @Html.DropDownListFor(m => m.ExpiryMonth,
                                Enumerable.Range(1, 12).Select(i => new SelectListItem { Value = i.ToString(), Text = i.ToString("00") }),
                                "-- MM --", new { @class = "sc-input" })
                            @Html.ValidationMessageFor(m => m.ExpiryMonth, "", new { @class = "text-danger" })
                        </div>
                        <div class="sc-field">
                            @Html.Label("Expiry year")
                            @Html.DropDownListFor(m => m.ExpiryYear,
                                Enumerable.Range(System.DateTime.Now.Year, 15).Select(y => new SelectListItem { Value = y.ToString(), Text = y.ToString() }),
                                "-- YYYY --", new { @class = "sc-input" })
                            @Html.ValidationMessageFor(m => m.ExpiryYear, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="sc-field" style="max-width:160px">
                        @Html.LabelFor(m => m.Cvv)
                        @Html.TextBoxFor(m => m.Cvv, new { @class = "sc-input", autocomplete = "off" })
                        @Html.ValidationMessageFor(m => m.Cvv, "", new { @class = "text-danger" })
                    </div>
                    <p class="text-muted"><small>Demo checkout — card details are validated and never stored.</small></p>
                </div>

                <div style="margin-top:20px">
                    <button type="submit" class="sc-btn sc-btn-primary sc-btn-lg sc-btn-block">Place Order</button>
                </div>
            }
        </div>
        <aside class="sc-summary">
            <h3>Order Summary</h3>
            @if (summary != null)
            {
                foreach (var item in summary.Items)
                {
                    <div class="sc-summary-row"><span>@item.Quantity &times; @item.ProductName</span><span>@item.LineTotal.ToString("C")</span></div>
                }
                <div class="sc-summary-row"><span>Subtotal</span><span>@summary.SubTotal.ToString("C")</span></div>
                <div class="sc-summary-row"><span>Shipping (@summary.ShippingMethod)</span><span>@summary.ShippingCost.ToString("C")</span></div>
                <div class="sc-summary-row"><span>Tax</span><span>@summary.TaxAmount.ToString("C")</span></div>
                <div class="sc-summary-row total"><span>Total</span><span>@summary.Total.ToString("C")</span></div>
            }
        </aside>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
