@model Ecommerce.Core.Entities.Order
@{
    ViewBag.Title = "Order Confirmation";
}
<div class="sc-container">
    <div class="sc-page-head">
        <h1>Checkout</h1>
    </div>
    <ol class="sc-steps">
        <li class="done">1. Address</li>
        <li class="done">2. Shipping</li>
        <li class="done">3. Payment</li>
        <li class="active">4. Confirmation</li>
    </ol>

    <div class="sc-card sc-confirm-hero">
        <span class="sc-check">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
        </span>
        <h2>Thank you! Your order has been placed.</h2>
        <p class="text-muted">Order number: <strong style="color:var(--sc-ink)">@Model.OrderNumber</strong></p>
        <p>@Html.ActionLink("Continue Shopping", "Index", "Product", null, new { @class = "sc-btn sc-btn-primary", style = "margin-top:10px" })</p>
    </div>

    <div class="sc-checkout-layout" style="margin-top:24px">
        <div>
            <div class="sc-card">
                <h3>Items ordered</h3>
                <table class="sc-table">
                    <thead>
                        <tr><th>Product</th><th>Unit Price</th><th>Qty</th><th style="text-align:right">Line Total</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.OrderLines)
                        {
                            <tr>
                                <td>
                                    @line.ProductName
                                    @if (!string.IsNullOrWhiteSpace(line.VariantName))
                                    { <br /><small class="text-muted">@line.VariantName</small> }
                                </td>
                                <td>@line.UnitPrice.ToString("C")</td>
                                <td>@line.Quantity</td>
                                <td style="text-align:right">@line.LineTotal.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <aside>
            <div class="sc-card" style="margin-bottom:20px">
                <h3>Order details</h3>
                <div class="sc-summary-row"><span>Order number</span><span>@Model.OrderNumber</span></div>
                <div class="sc-summary-row"><span>Date</span><span>@Model.OrderDate.ToLocalTime().ToString("g")</span></div>
                <div class="sc-summary-row"><span>Status</span><span><span class="sc-status">@Model.Status</span></span></div>
                <div class="sc-summary-row"><span>Shipping</span><span>@Model.ShippingMethod</span></div>
                <div class="sc-summary-row"><span>Payment</span><span>@Model.PaymentMethod</span></div>
            </div>
            <div class="sc-summary">
                <h3>Totals</h3>
                <div class="sc-summary-row"><span>Subtotal</span><span>@Model.SubTotal.ToString("C")</span></div>
                <div class="sc-summary-row"><span>Shipping</span><span>@Model.ShippingCost.ToString("C")</span></div>
                <div class="sc-summary-row"><span>Tax</span><span>@Model.TaxAmount.ToString("C")</span></div>
                <div class="sc-summary-row total"><span>Total</span><span>@Model.Total.ToString("C")</span></div>
                <h3 style="margin-top:22px">Shipping address</h3>
                <p style="font-size:14px;margin:0">
                    @Model.ShipFirstName @Model.ShipLastName<br />
                    @Model.ShipStreet<br />
                    @Model.ShipCity, @Model.ShipState @Model.ShipPostalCode<br />
                    @Model.ShipCountry<br />
                    @Model.ShipEmail
                </p>
            </div>
        </aside>
    </div>
</div>
