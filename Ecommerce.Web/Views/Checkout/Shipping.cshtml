@model Ecommerce.Core.ViewModels.CheckoutShippingViewModel
@{
    ViewBag.Title = "Checkout - Shipping";
    var summary = ViewBag.Summary as Ecommerce.Core.ViewModels.CheckoutSummaryViewModel;
}
<div class="sc-container">
    <div class="sc-page-head">
        <div class="sc-crumbs">@Html.ActionLink("Home", "Index", "Home") &rsaquo; @Html.ActionLink("Cart", "Index", "Cart") &rsaquo; Checkout</div>
        <h1>Checkout</h1>
    </div>
    <ol class="sc-steps">
        <li class="done">@Html.ActionLink("1. Address", "Address", "Checkout")</li>
        <li class="active">2. Shipping</li>
        <li>3. Payment</li>
        <li>4. Confirmation</li>
    </ol>

    <div class="sc-checkout-layout">
        <div class="sc-card">
            <h3>Choose a shipping method</h3>
            @using (Html.BeginForm("Shipping", "Checkout", FormMethod.Post, new { role = "form", id = "shipping-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                foreach (var option in Model.Options)
                {
                    <label class="sc-ship-option">
                        @Html.RadioButtonFor(m => m.ShippingMethod, option.Code, new { @class = "shipping-option" })
                        <span>
                            <strong>@option.Name</strong><br />
                            <small>@option.Description</small>
                        </span>
                        <span class="sc-price">@option.Cost.ToString("C")</span>
                    </label>
                }
                @Html.ValidationMessageFor(m => m.ShippingMethod, "", new { @class = "text-danger" })

                <div style="margin-top:18px">
                    <button type="submit" class="sc-btn sc-btn-primary sc-btn-lg">Continue to Payment</button>
                </div>
            }
        </div>
        <aside class="sc-summary">
            <h3>Order Summary</h3>
            @if (summary != null)
            {
                <div class="sc-summary-row"><span>Items (@summary.ItemCount)</span><span>@summary.SubTotal.ToString("C")</span></div>
                <div class="sc-summary-row"><span>Shipping</span><span id="summary-shipping">@summary.ShippingCost.ToString("C")</span></div>
                <div class="sc-summary-row"><span>Tax</span><span>@summary.TaxAmount.ToString("C")</span></div>
                <div class="sc-summary-row total"><span>Total</span><span id="summary-total">@summary.Total.ToString("C")</span></div>
            }
        </aside>
    </div>
</div>
