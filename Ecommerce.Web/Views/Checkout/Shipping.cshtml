@model Ecommerce.Core.ViewModels.CheckoutShippingViewModel
@{
    ViewBag.Title = "Checkout - Shipping";
    var summary = ViewBag.Summary as Ecommerce.Core.ViewModels.CheckoutSummaryViewModel;
}
<h2>Checkout</h2>
<ol class="breadcrumb checkout-steps">
    <li>@Html.ActionLink("1. Address", "Address", "Checkout")</li>
    <li class="active">2. Shipping</li>
    <li>3. Payment</li>
    <li>4. Confirmation</li>
</ol>

<div class="row">
    <div class="col-md-7">
        @using (Html.BeginForm("Shipping", "Checkout", FormMethod.Post, new { @class = "form-horizontal", role = "form", id = "shipping-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <h4>Choose a shipping method</h4>
            foreach (var option in Model.Options)
            {
                <div class="radio">
                    <label>
                        @Html.RadioButtonFor(m => m.ShippingMethod, option.Code, new { @class = "shipping-option" })
                        <strong>@option.Name</strong> - @option.Cost.ToString("C")
                        <br /><small class="text-muted">@option.Description</small>
                    </label>
                </div>
            }
            @Html.ValidationMessageFor(m => m.ShippingMethod, "", new { @class = "text-danger" })

            <div class="form-group" style="margin-top:15px">
                <div class="col-md-12">
                    <button type="submit" class="btn btn-primary">Continue to Payment</button>
                </div>
            </div>
        }
    </div>
    <div class="col-md-5">
        <div class="panel panel-default">
            <div class="panel-heading"><h4 class="panel-title">Order Summary</h4></div>
            <div class="panel-body" id="shipping-summary">
                @if (summary != null)
                {
                    <p>Items (@summary.ItemCount): @summary.SubTotal.ToString("C")</p>
                    <p>Shipping: <span id="summary-shipping">@summary.ShippingCost.ToString("C")</span></p>
                    <p>Tax: @summary.TaxAmount.ToString("C")</p>
                    <hr />
                    <p><strong>Total: <span id="summary-total">@summary.Total.ToString("C")</span></strong></p>
                }
            </div>
        </div>
    </div>
</div>
