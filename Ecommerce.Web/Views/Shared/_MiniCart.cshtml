@model Ecommerce.Core.ViewModels.MiniCartViewModel
@* Header mini-cart fragment. Refreshed via AJAX after add-to-cart. *@
<a href="@Url.Action("Index", "Cart")" class="sc-icon-btn" title="View cart (@Model.ItemCount item(s), @Model.SubTotal.ToString("C"))" aria-label="View cart">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" /></svg>
    @if (Model.ItemCount > 0)
    {
        <span class="sc-cart-count">@Model.ItemCount</span>
    }
</a>
