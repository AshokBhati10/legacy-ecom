@* Shopcart header: utility bar, logo + search + account/cart actions, category nav. *@
<div class="sc-topbar">
    <div class="sc-container">
        <span>Free delivery on orders over $50</span>
        <span>
            @Html.ActionLink("Products", "Index", "Product")
            <span class="sc-dot">|</span>
            @if (Request.IsAuthenticated)
            {
                @Html.ActionLink("My Orders", "Orders", "Account")
            }
            else
            {
                @Html.ActionLink("Sign in", "Login", "Account")
            }
        </span>
    </div>
</div>

<header class="sc-header">
    <div class="sc-header-main">
        <div class="sc-container">
            <a class="sc-logo" href="@Url.Action("Index", "Home")" aria-label="Shopcart home">
                <span class="sc-logo-mark">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" /></svg>
                </span>
                <span class="sc-logo-name">Shop<em>cart</em></span>
            </a>

            <div class="sc-search">
                @using (Html.BeginForm("Index", "Product", FormMethod.Get, new { role = "search" }))
                {
                    <input type="text" name="q" placeholder="Search products, brands and categories..." value="@Request["q"]" aria-label="Search products" />
                    <button type="submit">Search</button>
                }
            </div>

            <div class="sc-header-actions">
                @if (Request.IsAuthenticated)
                {
                    <a class="sc-account-link" href="@Url.Action("Orders", "Account")" title="My account">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        <span>Hello, @User.Identity.Name</span>
                    </a>
                    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", style = "display:inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <a class="sc-account-link" href="javascript:document.getElementById('logoutForm').submit()" title="Log off">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                            <span>Log off</span>
                        </a>
                    }
                }
                else
                {
                    <a class="sc-account-link" href="@Url.Action("Login", "Account")" title="Sign in / Register">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        <span>Account</span>
                    </a>
                }
                <span id="mini-cart">@Html.Action("MiniCart", "Cart")</span>
            </div>

            <button type="button" class="sc-menu-toggle" id="sc-menu-toggle" aria-label="Open menu">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
            </button>
        </div>
    </div>

    <nav class="sc-nav" aria-label="Categories">
        <div class="sc-container">
            @Html.ActionLink("Home", "Index", "Home", null, new { @class = "sc-nav-link" })
            @Html.ActionLink("All Products", "Index", "Product", null, new { @class = "sc-nav-link" })
            @Html.Action("CategoryTree", "Product", new { parentId = (int?)null })
        </div>
    </nav>

    <div class="sc-mobile-panel" id="sc-mobile-panel">
        <div class="sc-search">
            @using (Html.BeginForm("Index", "Product", FormMethod.Get, new { role = "search" }))
            {
                <input type="text" name="q" placeholder="Search products..." value="@Request["q"]" aria-label="Search products" />
                <button type="submit">Go</button>
            }
        </div>
        <nav>
            @Html.ActionLink("Home", "Index", "Home")
            @Html.ActionLink("All Products", "Index", "Product")
            @Html.ActionLink("Cart", "Index", "Cart")
            @if (Request.IsAuthenticated)
            {
                @Html.ActionLink("My Orders", "Orders", "Account")
            }
            else
            {
                @Html.ActionLink("Sign in", "Login", "Account")
                @Html.ActionLink("Register", "Register", "Account")
            }
        </nav>
    </div>
</header>
@* Anti-forgery token for AJAX POSTs (read by site.js). *@
@Html.AntiForgeryToken()
